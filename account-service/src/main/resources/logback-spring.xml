<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="service"
                    source="spring.application.name" defaultValue="account-service"/>

    <!-- Docker'da: JSON log (MDC'deki correlationId otomatik ayrı alan olarak eklenir) -->
    <springProfile name="docker">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
    </springProfile>

    <!-- Diğer her yerde (IntelliJ): Spring Boot'un okunabilir varsayılan formatı -->
    <springProfile name="!docker">
        <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>