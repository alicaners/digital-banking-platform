{
  "info": {
    "_postman_id": "9ab07f7d-05ea-4dc3-a686-a117e927fb19",
    "name": "Digital Banking Platform",
    "description": "Gateway (http://localhost:8080) üzerinden uçtan uca senaryo: kayıt, giriş, müşteri, hesap, transfer ve refresh token / logout.\n\nKullanım: 'Banking Local' ortamını seç, klasörleri sırayla çalıştır (ya da Collection Runner ile hepsini, istekler arası gecikme 1200 ms). Gateway rate limiter'ı 10 saniyede 10 isteğe izin verir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth - Kayıt ve giriş",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Her çalıştırmada yeni bir kullanıcı adı üretir (pre-request script) ve ortama yazar."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = 'demo' + String(Date.now()).slice(-8);",
                  "pm.environment.set('username', u);",
                  "pm.environment.set('email', u + '@example.com');",
                  "pm.environment.set('password', 'Test1234!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Kayıt başarılı', () => pm.expect(pm.response.json().message).to.eql('Kayıt başarılı'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Yanıttaki token ve refreshToken ortam değişkenlerine otomatik yazılır; sonraki isteklerin Authorization başlığı {{accessToken}} ile dolar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('access token (token) döndü', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.test('refreshToken döndü', () => pm.expect(json.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('accessToken', json.token);",
                  "pm.environment.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Customers",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"User\",\n  \"identityNumber\": \"{{identityNumber}}\",\n  \"email\": \"{{email}}\",\n  \"phoneNumber\": \"5550000000\",\n  \"address\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('identityNumber', String(Date.now()).slice(-11));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "pm.test('müşteri id döndü', () => pm.expect(json.id).to.exist);",
                  "pm.environment.set('customerId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
