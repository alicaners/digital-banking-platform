    {
      "name": "4. Transactions",
      "item": [
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderAccountId\": {{accountId1}},\n  \"receiverAccountId\": {{accountId2}},\n  \"amount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Her gönderimde yeni bir Idempotency-Key (GUID) üretilir."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Transfer COMPLETED', () => pm.expect(json.status).to.eql('COMPLETED'));",
                  "if (json.id !== undefined) { pm.environment.set('lastTransactionId', String(json.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer - replay (aynı Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderAccountId\": {{accountId1}},\n  \"receiverAccountId\": {{accountId2}},\n  \"amount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Önceki 'Transfer' isteğinin anahtarını yeniden kullanır (yeni anahtar üretmez). Bakiye ikinci kez düşmez."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Önceki sonuç döndü, yeni transfer yapılmadı (aynı işlem id)', () => {",
                  "  const last = pm.environment.get('lastTransactionId');",
                  "  if (last !== undefined && json.id !== undefined) { pm.expect(String(json.id)).to.eql(last); }",
                  "  pm.expect(json.status).to.eql('COMPLETED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Auth - Oturum yönetimi (refresh token ve logout)",
      "item": [
        {
          "name": "Refresh (rotation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Eski refresh token iptal edilir, yenisi verilir. Eski token 'previousRefreshToken' değişkeninde saklanır."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('previousRefreshToken', pm.environment.get('refreshToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Yeni refresh token öncekinden farklı (rotation)', () => pm.expect(json.refreshToken).to.not.eql(pm.environment.get('previousRefreshToken')));",
                  "pm.test('Mesaj: Token yenilendi', () => pm.expect(json.message).to.eql('Token yenilendi'));",
                  "pm.test('access token (token) döndü', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.test('refreshToken döndü', () => pm.expect(json.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('accessToken', json.token);",
                  "pm.environment.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - eski token ile tekrar (reuse, 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{previousRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Daha önce kullanılmış (iptal edilmiş) token reddedilir. Ayrıca kullanıcının TÜM aktif refresh token'ları iptal edilir (reuse tespiti)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Hata mesajı: Geçersiz refresh token', () => pm.expect(pm.response.json().error).to.eql('Geçersiz refresh token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - reuse sonrası yeni token da iptal (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Reuse tespiti kullanıcının diğer token'larını da iptal ettiği için, henüz kullanılmamış olan güncel refresh token da artık geçersizdir."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Hata mesajı: Geçersiz refresh token', () => pm.expect(pm.response.json().error).to.eql('Geçersiz refresh token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (yeniden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('access token (token) döndü', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.test('refreshToken döndü', () => pm.expect(json.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('accessToken', json.token);",
                  "pm.environment.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Refresh token'ı iptal eder. Access token süresi dolana kadar (15 dk) geçerli kalır."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - logout sonrası (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Hata mesajı: Geçersiz refresh token', () => pm.expect(pm.response.json().error).to.eql('Geçersiz refresh token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout - tekrar (idempotent, 204)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Zaten iptal edilmiş token için de 204 döner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}