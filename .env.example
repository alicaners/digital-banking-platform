# Bu dosya bir örnektir, gerçek değerleri içermez.
# Gerçek kullanım için bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin.
# .env dosyası .gitignore'da olduğu için Git'e yüklenmez.

JWT_SECRET=buraya-kendi-guclu-gizli-anahtarinizi-yazin-en-az-32-karakter
JWT_EXPIRATION=3600000

DB_USERNAME=banking_user
DB_PASSWORD=banking_pass

# Not: Şu an sadece JWT secret için ortam değişkeni kullanılıyor.
# Veritabanı şifreleri (account_db, customer_db vb.) ve Kafka
# bağlantı bilgileri henüz application.yml içinde doğrudan
# tanımlı - ileride bunlar da ortam değişkenine taşınabilir.